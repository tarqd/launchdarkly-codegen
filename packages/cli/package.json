{
  "name": "@launchtarqly/codegen",
  "version": "0.1.0",
  "description": "Generates type-safe wrappers around the official LaunchDarkly SDKs",
  "type": "module",
  "bin": {
    "launchtarqly-codegen": "./dist/main.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@launchtarqly/core": "workspace:*",
    "@launchtarqly/emit-ts-server": "workspace:*"
  }
}
