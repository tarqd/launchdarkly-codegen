{
  "name": "@launchtarqly/codegen",
  "version": "0.1.1",
  "description": "Generates type-safe wrappers around the official LaunchDarkly SDKs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarqd/launchdarkly-codegen.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "launchtarqly-codegen": "./bundle/launchtarqly-codegen.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./bundle/index.js"
    }
  },
  "files": [
    "bundle"
  ],
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "prepack": "node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@launchtarqly/core": "workspace:*",
    "@launchtarqly/emit-dotnet": "workspace:*",
    "@launchtarqly/emit-go": "workspace:*",
    "@launchtarqly/emit-java": "workspace:*",
    "@launchtarqly/emit-ts-server": "workspace:*",
    "esbuild": "0.28.2",
    "yaml": "2.8.1"
  }
}
